# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev shell override (Windows-only path, breaks Linux CI/Vercel)
.npmrc

# static LMS export (regenerate with `npm run build:lms`)
/lms-build/
/AI_TL_Essentials_Level1_LMS.zip

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
